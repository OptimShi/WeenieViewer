<TabItem x:Class="WeenieViewer.Controls.TabGenerator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeenieViewer.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
         Header="Generator" x:Name="tabGenerator"
         >
    <Grid Background="#FFE5E5E5">
        <RichTextBox x:Name="txtInfo" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
            <FlowDocument>
                <Paragraph>
                    <Run Text="RichTextBox" x:Name="genText"/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</TabItem>
